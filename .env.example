# Local Docker configuration. Copy to .env; never commit real credentials.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://counterpart:counterpart@localhost:5432/counterpart
WEB_URL=http://localhost:3010
PUBLIC_API_URL=http://localhost:8010
CORS_ORIGINS=http://localhost:3010
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=counterpart-local
S3_SECRET_ACCESS_KEY=replace-with-a-random-password-at-least-16-characters
S3_BUCKET=counterpart
S3_REGION=us-east-1
S3_PUBLIC_URL=
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_FROM=Counterpart <notifications@counterpart.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
ABLY_API_KEY=
# Docker overrides Redis with its local service and QStash with dev signing keys.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_CALLBACK_URL=
# Enable only after the Didit MCP setup, workflow and signed webhook are verified.
VERIFICATION_ENABLED=false
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Deployment-only credentials; do not pass these Cloudflare tokens to services.
PRODUCTION_DATABASE_URL=
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://cdn.counterpart.ph
PRODUCTION_SMTP_HOST=smtp.zeptomail.com
PRODUCTION_SMTP_PORT=587
PRODUCTION_SMTP_USERNAME=emailapikey
PRODUCTION_SMTP_PASSWORD=
PRODUCTION_SMTP_STARTTLS=true
PRODUCTION_SMTP_FROM=Counterpart <noreply@counterpart.ph>
